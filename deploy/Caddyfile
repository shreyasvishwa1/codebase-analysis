{
	admin off
	servers {
		# The hosting platform's edge proxy sets X-Forwarded-For; trust it only from private
		# and shared address ranges so the backend sees each visitor's real IP for rate limits.
		# Strict mode reads the chain right to left and takes the first untrusted address, so a
		# visitor cannot pick their own IP by sending an X-Forwarded-For header.
		trusted_proxies static private_ranges 100.64.0.0/10
		trusted_proxies_strict
		# Header holding the visitor's address: X-Forwarded-For by default. Behind Cloudflare
		# (Render), set CLIENT_IP_HEADER=Cf-Connecting-Ip: Cloudflare sets it to the visitor and
		# overwrites any value they send, while X-Forwarded-For ends with Cloudflare's own address.
		client_ip_headers {$CLIENT_IP_HEADER:X-Forwarded-For}
	}
}

# Hand the API only the visitor's address as Caddy resolved it. Passing the whole chain made
# uvicorn take the last hop (the platform proxy or this host), so every visitor shared one IP.
(api) {
	reverse_proxy 127.0.0.1:8000 {
		header_up X-Forwarded-For {client_ip}
	}
}

:{$PORT:8080} {
	encode gzip

	handle /api/* {
		# Only repository uploads carry large bodies (the API enforces MAX_UPLOAD_SIZE_MB on
		# them); every other request body is capped here, before it reaches the application.
		@small not path_regexp ^/api/v1/projects/[^/]+/repositories/[^/]+/ingest$
		request_body @small {
			max_size 2MB
		}
		import api
	}
	handle /health {
		import api
	}

	# Hidden files never exist on this site: /.env, /.git/... get a plain 404 rather than the
	# app page (the standard /.well-known/ folder excepted).
	@hidden {
		path_regexp ^/\.
		not path /.well-known/*
	}
	handle @hidden {
		respond 404
	}

	# Built assets: a missing file is a 404, never the app page.
	handle /assets/* {
		root * /app/frontend/dist
		file_server
	}

	# The single-page app: unknown paths fall back to index.html for client-side routes.
	handle {
		root * /app/frontend/dist
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		# Scripts only from this origin, plus the inline theme script in index.html by its
		# hash (update the hash if that script changes; a test checks they match). Styles and
		# fonts also from Google Fonts. Nothing may frame the app or load plugins.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-EhDTmW3oJ9AlKl/v2xozsvROowVdxXASelS3RSDRS5o='; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		# HTTPS only for a year once a browser has seen the site over HTTPS (browsers ignore
		# this header on plain HTTP, so local runs are unaffected).
		Strict-Transport-Security "max-age=31536000"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy same-origin
		-Server
	}
}
